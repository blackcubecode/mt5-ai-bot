@"
# Virtual Environment
venv/
env/
ENV/

# Environment Variables (SENSITIF)
.env

# Model Files (terlalu besar untuk GitHub)
models/*.pkl
models/*.h5
models/*.onnx

# Data Files
data/
*.csv
*.parquet

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
"@ | Out-File -FilePath .gitignore -Encoding utf8
